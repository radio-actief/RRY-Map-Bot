# RRY-Map-Bot Production Environment Variables
# Copy this file to .env.production and fill in your values

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# Bot Instructions Post (optional)
STARTUP_CHANNEL_ID=your_channel_id_here
STARTUP_MESSAGE_ID=your_message_id_here

# Database Configuration
DATABASE_PATH=/app/data/belgian_nodes.db

# Local Belgian Geocoder (default path used by sync_belgian_nodes.py)
# Built by: python3 scripts/generate-be-municipalities-geojson.py
BE_MUNICIPALITIES_GEOJSON=/app/data/be-municipalities.geojson
# Buffer (metres, EPSG:3812). 0 = strict point-in-polygon (recommended for sync).
GEOCODE_BUFFER_METERS=0

# Geopy / Nominatim (FALLBACK ONLY — used with --use-geopy or USE_GEOPY_FALLBACK=1,
# and auto-used if BE_MUNICIPALITIES_GEOJSON is missing at runtime)
GEOPY_USER_AGENT=RRY-Map-Bot/1.0
GEOPY_DELAY=1.5
USE_GEOPY_FALLBACK=0

# API Configuration
API_URL=https://map.meshcore.io/api/v1/nodes
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
FLASK_DEBUG=False

# Sync Configuration
# SYNC_INTERVAL_MINUTES is preferred; legacy SYNC_INTERVAL_HOURS still supported
# (used as a fallback when SYNC_INTERVAL_MINUTES is unset).
SYNC_INTERVAL_MINUTES=30
# SYNC_INTERVAL_HOURS=6

# Daily Digest (posted once per day by the discord-bot service)
DAILY_DIGEST_ENABLED=1
DAILY_DIGEST_HOUR=9
DAILY_DIGEST_MINUTE=0
DAILY_DIGEST_TZ=Europe/Brussels
# Optional; defaults to STARTUP_CHANNEL_ID
# DAILY_DIGEST_CHANNEL_ID=your_channel_id

# Discord OAuth2 (for web app authentication)
# Get these from https://discord.com/developers/applications
DISCORD_OAUTH2_CLIENT_ID=your_discord_oauth2_client_id
DISCORD_OAUTH2_CLIENT_SECRET=your_discord_oauth2_client_secret
DISCORD_OAUTH2_REDIRECT_URI=https://your-domain.com/auth/callback

# Flask Session Configuration
# Generate a secure random key: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_secret_key_here
SESSION_COOKIE_SECURE=True  # Must be True for HTTPS (production)
