# RRY-Map-Bot Environment Variables for Docker Volumes
# Copy this file to rry-map-bot.env in your stack directory (/path/to/stack/)
# and update the paths as needed.

# Data directory - where the SQLite database is stored
# The database file will be at: ${DATA_DIR}/belgian_nodes.db
DATA_DIR=/path/to/stack/data

# Logs directory - where application logs are stored
LOGS_DIR=/path/to/stack/logs

