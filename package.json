{
  "name": "rry-map-bot",
  "version": "1.0.0",
  "description": "MeshCore Map Frontend - Utility script for parsing meshcore:// links",
  "type": "module",
  "scripts": {
    "parse-link": "node parse_meshcore_link.mjs",
    "dev": "vite --config web/configurator/vite.config.ts",
    "build": "vite build --config web/configurator/vite.config.ts",
    "test": "vitest run --config web/configurator/vite.config.ts",
    "typecheck": "tsc -p web/configurator --noEmit"
  },
  "dependencies": {
    "@liamcottle/meshcore.js": "^1.10.0",
    "@preact/signals": "^2.11.3",
    "leaflet": "^1.9.4",
    "preact": "^11.0.2",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
