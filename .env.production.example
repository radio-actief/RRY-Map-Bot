# RRY-Map-Bot Production Environment Variables
# Copy this file to .env.production and fill in your values

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# Bot Instructions Post (optional)
STARTUP_CHANNEL_ID=your_channel_id_here
STARTUP_MESSAGE_ID=your_message_id_here

# Database Configuration
DATABASE_PATH=/app/data/belgian_nodes.db

# Geopy Configuration
GEOPY_USER_AGENT=RRY-Map-Bot/1.0
GEOPY_DELAY=1.5

# API Configuration
API_URL=https://map.meshcore.dev/api/v1/nodes
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
FLASK_DEBUG=False

# Sync Configuration
SYNC_INTERVAL_HOURS=6
